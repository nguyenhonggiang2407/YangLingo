Options -Indexes
DirectoryIndex index.php

<FilesMatch "(?i)^(config\.local\.php|config\.example\.php|README\.md|TEST_REPORT\.md|CHANGELOG_FINAL\.md|SECURITY\.md|DEPLOY_HELIOHOST\.md|composer\.(json|lock)|\.env.*)$">
  Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(md|sql|log|ini|bak|dist)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:storage|lib|database|tests|docs)/ - [F,L,NC]
  RewriteRule ^\.git - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
